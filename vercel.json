{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":null,
  "buildCommand":"npm run build",
  "outputDirectory":"public",
  "functions":{"api/app.js":{"maxDuration":60,"includeFiles":"dist/server/**"}},
  "routes":[{"handle":"filesystem"},{"src":"/(.*)","dest":"/api/app?__path=$1"}]
}
