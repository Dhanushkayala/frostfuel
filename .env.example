# NETLIFY: set ADMIN_PASSWORD in the Netlify UI with Functions scope. Blobs credentials are automatic.
# VERCEL: configure all three variables below in the Vercel UI.
# Never commit real values.
ADMIN_PASSWORD=
# Token for a PRIVATE Vercel Blob store (clients, enquiries, settings).
BLOB_READ_WRITE_TOKEN=
# Token for a separate PUBLIC Vercel Blob store (website pictures and videos only).
MEDIA_BLOB_READ_WRITE_TOKEN=
